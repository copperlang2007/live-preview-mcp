{
  "name": "live-preview-mcp",
  "version": "1.0.0",
  "description": "MCP Server for live app previews with iframe embedding, Docker, tunneling, and mobile support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "live-preview-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "ws": "^8.18.0",
    "dockerode": "^4.0.4",
    "portfinder": "^1.0.32",
    "tree-kill": "^1.2.2",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@types/dockerode": "^3.3.32",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "keywords": [
    "mcp",
    "preview",
    "live",
    "iframe",
    "docker",
    "tunnel"
  ],
  "license": "MIT"
}
